# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Koneksi database PostgreSQL. Untuk pengembangan lokal bisa memakai Postgres
# yang berjalan di Docker atau terinstall langsung. Untuk produksi, pakai
# connection string dari provider cloud (Supabase, Neon, Railway, RDS, dll).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grosir_app?schema=public"

# Secret untuk NextAuth — WAJIB diganti dengan nilai acak & rahasia di produksi.
# Bisa generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-nilai-acak-yang-panjang"
NEXTAUTH_SECRET="ganti-dengan-nilai-acak-yang-panjang"

# URL aplikasi. Untuk lokal biarkan seperti ini, untuk produksi isi domain asli.
NEXTAUTH_URL="http://localhost:3000"
